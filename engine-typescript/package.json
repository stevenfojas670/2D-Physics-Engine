{
	"name": "engine-typescript",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint . && prettier --check . && node scripts/checkReadmes.mjs",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"bench": "vitest bench --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.5.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.4",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1"
	}
}
